{
  "deployWorkflow": "pages.yml",
  "collections": [
    {
      "name": "Įrašai",
      "folder": "app/_data/_blog",
      "imageFolder": "public/images",
      "imageUrlPrefix": "/images",
      "fields": [
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "summary",
          "type": "textarea"
        },
        {
          "name": "topic",
          "type": "select",
          "options": [
            "Statyba",
            "Žinios",
            "Bitynas",
            "Spiečiai"
          ]
        },
        {
          "name": "date",
          "type": "date"
        },
        {
          "name": "photos",
          "type": "gallery"
        },
        {
          "name": "body",
          "type": "markdown"
        }
      ]
    }
  ],
  "singles": [
    {
      "name": "Bitynas skaičiais",
      "file": "app/_data/stats.md",
      "fields": [
        {
          "name": "aviliai",
          "type": "number"
        },
        {
          "name": "sodai",
          "type": "number"
        },
        {
          "name": "seimos",
          "type": "number",
          "label": "bičių šeimos"
        }
      ]
    }
  ]
}
